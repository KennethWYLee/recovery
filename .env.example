# Production and staging users must be supplied by the hosting platform's
# authenticated identity headers. Local identity values are intentionally absent.
CLASSROOM_ENVIRONMENT=production

# Required for traceable production evidence. Use the deployed commit SHA or release ID.
CLASSROOM_RELEASE=replace-with-deployment-id

# Optional comma-separated additions to the two fixed system administrators.
# CLASSROOM_ADMIN_EMAILS=another-admin@ntub.edu.tw
