# Production identity must come from platform-verified headers. The initial
# administrator is provisioned only when that verified email matches this value.
CONTINUITY_OPS_ENVIRONMENT=production
CONTINUITY_OPS_ORGANIZATION_NAME=Example Operations
CONTINUITY_OPS_ORGANIZATION_TIMEZONE=UTC
CONTINUITY_OPS_BOOTSTRAP_ADMIN_EMAIL=continuity-admin@example.invalid
# Immutable release identifier included in structured request telemetry. Replace
# before staging or production; an unset value is reported as "unversioned".
CONTINUITY_OPS_DEPLOYMENT_VERSION=replace-with-immutable-source-or-artifact-id
# Store this as a platform secret, not a plaintext deployment variable. Use an
# independently generated value of at least 32 characters per environment.
CONTINUITY_OPS_CURSOR_HMAC_SECRET=replace-with-random-secret-at-least-32-characters
# Public HTTPS origin used to generate the mobile sign-in QR code. Set it to
# the deployed site's origin, without a path, query, or fragment.
CONTINUITY_OPS_PUBLIC_ORIGIN=https://continuity-ops.example.com

# Comma-separated verified accounts allowed to create and manage courses.
CLASSROOM_TEACHER_EMAILS=wy.lee@ntub.edu.tw

# Local operator identity is accepted only for localhost development. Production
# deployments must not define these local-development values. Valid organization
# roles are admin, commander, responder, observer, and auditor.
# CONTINUITY_OPS_LOCAL_OPERATOR_ID=local-operator
# CONTINUITY_OPS_LOCAL_OPERATOR_NAME=Local Operator
# CONTINUITY_OPS_LOCAL_OPERATOR_EMAIL=local-operator@example.invalid
# CONTINUITY_OPS_LOCAL_OPERATOR_ROLE=admin
