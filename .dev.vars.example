# Copy to .dev.vars for local development and never commit the resulting file.
# Local operator identity is accepted only for localhost requests.
CONTINUITY_OPS_ENVIRONMENT=development
CONTINUITY_OPS_ORGANIZATION_NAME=Continuity Ops Local
CONTINUITY_OPS_ORGANIZATION_TIMEZONE=Asia/Taipei
CONTINUITY_OPS_BOOTSTRAP_ADMIN_EMAIL=local-operator@example.invalid
CONTINUITY_OPS_DEPLOYMENT_VERSION=local-development
# Local-only signing key. Use an independently generated secret of at least 32
# characters in each deployed environment; never commit a real value.
CONTINUITY_OPS_CURSOR_HMAC_SECRET=replace-with-local-random-secret-at-least-32-characters
# QR sign-in is intentionally hidden on localhost. Set this only when testing
# through a public HTTPS development URL.
# CONTINUITY_OPS_PUBLIC_ORIGIN=https://continuity-ops-development.example.com
CONTINUITY_OPS_LOCAL_OPERATOR_ID=local-operator
CONTINUITY_OPS_LOCAL_OPERATOR_NAME=Local Operator
CONTINUITY_OPS_LOCAL_OPERATOR_EMAIL=local-operator@example.invalid
CONTINUITY_OPS_LOCAL_OPERATOR_ROLE=admin
